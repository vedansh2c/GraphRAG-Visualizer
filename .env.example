# Docker Compose reads .env. Java startup reads exported environment variables.
APP_PORT=8080
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_PASSWORD=explorer-local-password
# Leave empty for deterministic offline processing.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
MODEL_TIMEOUT=90
COMMUNITY_DETECTOR=gds
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=40MB
MAX_FILES=20
MAX_TOTAL_BYTES=40000000
PASSAGE_SIZE=6000
PASSAGE_OVERLAP=600
CHUNK_SIZE=500
SEED_LIMIT=3
RELATIONSHIP_LIMIT=10
PASSAGE_LIMIT=5
COMMUNITY_LIMIT=3
PASSAGES_PER_COMMUNITY=2
FOLLOWUP_LIMIT=3
VECTOR_CONTEXT=5
VECTOR_INSPECT=12
